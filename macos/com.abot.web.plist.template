<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. macos/install.sh fills __ROOT__, __ALIAS__, __HOME__ and installs
     this to ~/Library/LaunchAgents/com.abot.web.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abot.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/macos/abot-launchd.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ABOT_ROOT</key>
    <string>__ROOT__</string>
    <key>ABOT_HOST_ALIAS</key>
    <string>__ALIAS__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/abot-web.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/abot-web.log</string>
</dict>
</plist>
