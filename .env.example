# Abot environment (optional). All values have safe defaults in server/abot-web.js.
# On WSL these are usually set by scripts/abot-web-start-wsl.sh, not here.

# This host's short name, shown in the dashboard and /api/status.
ABOT_HOST_ALIAS=host1

# Where the dashboard binds (localhost only; Tailscale exposes it).
ABOT_WEB_PORT=17900
ABOT_TTYD_PORT=17880

# tmux work session ttyd attaches to on first load.
ABOT_TMUX_SESSION=dev

# Host roster for the dashboard switcher (JSON array). See config/hosts.example.json.
# Default: ~/.abot/hosts.json
# ABOT_HOSTS_FILE=/home/you/.abot/hosts.json

# Single-host fallback used only when the roster file is missing:
# ABOT_SELF_URL=https://host1.YOUR-TAILNET.ts.net:9443/
# ABOT_SELF_PUBLIC_URL=https://host1.YOUR-TAILNET.ts.net:8443/

# Auth: file ~/.abot-auth ("user:pass" or {"user","pass"}). Env overrides file.
# ABOT_AUTH_USER=abot
# ABOT_AUTH_PASS=change-me-strong

# Session cookie secret file (auto-generated if absent). Keep private.
# ABOT_SESSION_SECRET_FILE=/home/you/.abot-session-secret
